{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run prepare-content && next dev",
    "build": "npm run prepare-content && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "npm run prepare-content && fumadocs-mdx && tsc --noEmit",
    "prepare-content": "node scripts/sync-engine.mjs && node scripts/bundle-docs.mjs",
    "postinstall": "node scripts/sync-engine.mjs && fumadocs-mdx",
    "deploy": "npm run prepare-content && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "npm run prepare-content && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "npm run prepare-content && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@opennextjs/cloudflare": "^1.20.3",
    "@paper-design/shaders-react": "^0.0.81",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fumadocs-core": "^16.15.17",
    "fumadocs-mdx": "^15.4.5",
    "lucide": "^1.49.0",
    "morphicons": "^1.7.1",
    "motion": "^13.4.6",
    "next": "^16.3.7",
    "opentype.js": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sileo": "^0.1.5",
    "simple-icons": "^16.33.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20.19.43",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9",
    "eslint-config-next": "^16.3.7",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5.7.4",
    "wrangler": "^4.145.0"
  }
}
